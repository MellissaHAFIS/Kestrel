node_modules/

# Secrets: real env files are ignored, templates are tracked
.env
.env.*
!.env.example
!.env.aws.example
# demo/fixture_repo/.env is a deliberate FAKE (canary) and must stay tracked
!demo/fixture_repo/.env

# Local data
*.db
*.sqlite3
demo/leak_log.jsonl
eval/results/

