<mxfile host="app.diagrams.net" version="24.0.0"><diagram id="arch" name="1 - Architecture"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2560" pageHeight="2040" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;PolicyGuard — Solution architecture (Step 2 template: Interface / Orchestration / Intelligence / Data)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=19;" vertex="1" parent="1"><mxGeometry x="64" y="0" width="1440" height="51" as="geometry"/></mxCell><mxCell id="legend" value="solid arrow = runtime flow · dashed = conditional / attack path · yellow = proposed, to confirm" style="text;html=1;align=right;verticalAlign=middle;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1600" y="0" width="832" height="51" as="geometry"/></mxCell><mxCell id="L1_bg" value="" style="rounded=0;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;opacity=55;" vertex="1" parent="1"><mxGeometry x="160" y="68" width="2272" height="238" as="geometry"/></mxCell><mxCell id="L1_tab" value="INTERFACE LAYER" style="rounded=0;html=1;fillColor=#6c8ebf;strokeColor=#6c8ebf;fontColor=#ffffff;fontStyle=1;fontSize=16;horizontal=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="64" y="68" width="90" height="238" as="geometry"/></mxCell><mxCell id="L2_bg" value="" style="rounded=0;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;opacity=55;" vertex="1" parent="1"><mxGeometry x="160" y="357" width="2272" height="612" as="geometry"/></mxCell><mxCell id="L2_tab" value="ORCHESTRATION LAYER" style="rounded=0;html=1;fillColor=#d79b00;strokeColor=#d79b00;fontColor=#ffffff;fontStyle=1;fontSize=16;horizontal=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="64" y="357" width="90" height="612" as="geometry"/></mxCell><mxCell id="L3_bg" value="" style="rounded=0;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;opacity=55;" vertex="1" parent="1"><mxGeometry x="160" y="1020" width="2272" height="255" as="geometry"/></mxCell><mxCell id="L3_tab" value="INTELLIGENCE LAYER" style="rounded=0;html=1;fillColor=#9673a6;strokeColor=#9673a6;fontColor=#ffffff;fontStyle=1;fontSize=16;horizontal=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="64" y="1020" width="90" height="255" as="geometry"/></mxCell><mxCell id="L4_bg" value="" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;opacity=55;" vertex="1" parent="1"><mxGeometry x="160" y="1326" width="2272" height="374" as="geometry"/></mxCell><mxCell id="L4_tab" value="DATA LAYER" style="rounded=0;html=1;fillColor=#82b366;strokeColor=#82b366;fontColor=#ffffff;fontStyle=1;fontSize=16;horizontal=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="64" y="1326" width="90" height="374" as="geometry"/></mxCell><mxCell id="u1" value="&lt;b&gt;Developer / User&lt;/b&gt;&lt;br&gt;task: finish the auth module" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=14;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="224" y="153" width="352" height="119" as="geometry"/></mxCell><mxCell id="ui" value="&lt;b&gt;Chainlit UI&lt;/b&gt;&lt;br&gt;Live feed (one line per event)&lt;br&gt;Investigation trace · Approve / Block buttons" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=14;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="704" y="136" width="448" height="136" as="geometry"/></mxCell><mxCell id="out" value="&lt;b&gt;Output&lt;/b&gt;&lt;br&gt;trace lines · risk score · verdicts&lt;br&gt;exportable audit trail (JSON / CSV)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=14;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1312" y="144" width="480" height="119" as="geometry"/></mxCell><mxCell id="inguard" value="&lt;b&gt;Input guard&lt;/b&gt;&lt;br&gt;intercepts every input" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=14;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="224" y="442" width="272" height="102" as="geometry"/></mxCell><mxCell id="dev" value="&lt;b&gt;DevAssist (protected agent)&lt;/b&gt;&lt;br&gt;LLM + tools, reason / act / observe&lt;br&gt;LangChain / LangGraph agent" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=14;strokeWidth=1.5;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="624" y="425" width="384" height="136" as="geometry"/></mxCell><mxCell id="outguard" value="&lt;b&gt;Output guard&lt;/b&gt;&lt;br&gt;intercepts every output" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=14;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1136" y="442" width="272" height="102" as="geometry"/></mxCell><mxCell id="dtools" value="&lt;b&gt;DevAssist tools (simulated)&lt;/b&gt;&lt;br&gt;read files · write code · open PRs&lt;br&gt;send notifications · HTTP / web search" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=14;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1504" y="425" width="384" height="136" as="geometry"/></mxCell><mxCell id="ext" value="&lt;b&gt;External endpoint&lt;/b&gt;&lt;br&gt;non-allowlisted domain: exfiltration target in the attack" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=14;strokeWidth=1.5;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;" vertex="1" parent="1"><mxGeometry x="2016" y="425" width="288" height="136" as="geometry"/></mxCell><mxCell id="eval" value="&lt;b&gt;Evaluation harness (offline)&lt;/b&gt;&lt;br&gt;variants: 0 no guard, A one-shot judge, B investigator&lt;br&gt;ASR · recall · FPR · benign utility · latency" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=14;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="224" y="646" width="320" height="187" as="geometry"/></mxCell><mxCell id="tg" value="&lt;b&gt;Tool guard&lt;/b&gt;&lt;br&gt;callbacks / middleware: every tool call" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=14;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="624" y="646" width="384" height="102" as="geometry"/></mxCell><mxCell id="inv" value="&lt;b&gt;PolicyGuard Investigator (agent)&lt;/b&gt;&lt;br&gt;LangGraph: triage, reason, tools, verdict, human_interrupt&lt;br&gt;State: action_under_review, evidence[], confidence, steps_used&lt;br&gt;Fast path: benign = ALLOW in 1 step · hard step budget about 6" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=14;strokeWidth=1.5;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="1152" y="595" width="608" height="170" as="geometry"/></mxCell><mxCell id="itools" value="&lt;b&gt;Investigator tools (read-only)&lt;/b&gt;&lt;br&gt;get_session_history · read_policy · scan_secrets · check_destination&lt;br&gt;classify_path · static_scan · check_canary · request_human_approval" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=14;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1152" y="816" width="608" height="136" as="geometry"/></mxCell><mxCell id="resp" value="&lt;b&gt;Response engine&lt;/b&gt;&lt;br&gt;ALLOW · BLOCK · SANITIZE · ESCALATE&lt;br&gt;escalate = human via LangGraph interrupt()" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=14;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#d79b00;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="1952" y="595" width="416" height="170" as="geometry"/></mxCell><mxCell id="fail" value="&lt;b&gt;Failure handling (proposed)&lt;/b&gt;&lt;br&gt;tool / LLM error or timeout: retry once, then escalate to human&lt;br&gt;budget used up or low confidence: escalate to human" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=14;strokeWidth=1.5;fillColor=#fff9c4;strokeColor=#c9a800;dashed=1;" vertex="1" parent="1"><mxGeometry x="1952" y="816" width="416" height="136" as="geometry"/></mxCell><mxCell id="m1" value="&lt;b&gt;Small fast model&lt;/b&gt;&lt;br&gt;DevAssist + triage&lt;br&gt;model TBD (event credits)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=14;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="304" y="1105" width="320" height="136" as="geometry"/></mxCell><mxCell id="m2" value="&lt;b&gt;Stronger model&lt;/b&gt;&lt;br&gt;Investigator reasoning&lt;br&gt;temperature 0 for verdicts · model TBD" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=14;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="752" y="1105" width="400" height="136" as="geometry"/></mxCell><mxCell id="m3" value="&lt;b&gt;Deterministic security tools&lt;/b&gt;&lt;br&gt;detect-secrets (ggshield if available)&lt;br&gt;Bandit or Semgrep · allowlist · canary" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=14;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1312" y="1105" width="400" height="136" as="geometry"/></mxCell><mxCell id="m4" value="&lt;b&gt;Prompting strategy and embeddings&lt;/b&gt;&lt;br&gt;rules retrieved by section; inspected content passed strictly as data&lt;br&gt;No embeddings / vector DB: YAML policy (demo scope)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=14;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1872" y="1105" width="528" height="136" as="geometry"/></mxCell><mxCell id="ls" value="&lt;b&gt;LangSmith&lt;/b&gt;&lt;br&gt;low-level traces of LLM and tool calls" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=14;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="304" y="1394" width="304" height="136" as="geometry"/></mxCell><mxCell id="d2" value="&lt;b&gt;Audit log (SQLite)&lt;/b&gt;&lt;br&gt;compliance-facing, exportable&lt;br&gt;session_id · timestamp · event_type · action · evidence · violation · severity · reasoning · decision · steps_used · latency_ms" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=14;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="640" y="1394" width="512" height="153" as="geometry"/></mxCell><mxCell id="d1" value="&lt;b&gt;Policy store (YAML) and session state&lt;/b&gt;&lt;br&gt;natural-language rules: never read .env, no POST to non-allowlisted domains&lt;br&gt;session history: what DevAssist did earlier" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=14;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1200" y="1394" width="528" height="153" as="geometry"/></mxCell><mxCell id="d4" value="&lt;b&gt;Simulated environment (attack scenario)&lt;/b&gt;&lt;br&gt;repo with a planted .env containing a canary token&lt;br&gt;third-party README / ticket with a hidden injection (untrusted)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=14;strokeWidth=1.5;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;" vertex="1" parent="1"><mxGeometry x="1760" y="1394" width="640" height="153" as="geometry"/></mxCell><mxCell id="d7" value="&lt;b&gt;Public benchmarks (offline evaluation)&lt;/b&gt;&lt;br&gt;InjecAgent subset · AgentDojo or R-Judge · about 10 custom multi-step chains" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=14;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="208" y="1581" width="912" height="85" as="geometry"/></mxCell><mxCell id="notes" value="&lt;b&gt;Peer review notes (Step 4)&lt;/b&gt;&lt;br&gt;&lt;b&gt;Problem in one sentence:&lt;/b&gt; nobody can verify that an AI agent does only what it was told to do; PolicyGuard supervises it with an investigating agent.&lt;br&gt;&lt;b&gt;Riskiest assumption:&lt;/b&gt; the Investigator loop (B) beats a one-shot judge (A) on multi-step chains; it will be tested and reported honestly either way.&lt;br&gt;&lt;b&gt;If a component fails (proposed):&lt;/b&gt; guard or tool error means escalate to a human, never a silent allow.&lt;br&gt;&lt;b&gt;10x scale:&lt;/b&gt; triage fast path and hard step budget limit cost and latency per action.&lt;br&gt;&lt;b&gt;Simplest 90-minute version (proposed):&lt;/b&gt; rules triage + scan_secrets + check_destination + SQLite log, on the demo chain only." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=14;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="160" y="1751" width="2272" height="221" as="geometry"/></mxCell><mxCell id="e1" value="task" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="u1" target="ui"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1b" value="displays" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ui" target="out"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="input" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.1;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="ui" target="inguard"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="749" y="316"/><mxPoint x="360" y="316"/></Array></mxGeometry></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="inguard" target="dev"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="output" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="dev" target="outguard"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="final output" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.714;entryY=1;" edge="1" parent="1" source="outguard" target="ui"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1272" y="332"/><mxPoint x="1024" y="332"/></Array></mxGeometry></mxCell><mxCell id="e6" value="every tool call" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.3;exitY=1;entryX=0.3;entryY=0;" edge="1" parent="1" source="dev" target="tg"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="action under review" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.6;" edge="1" parent="1" source="tg" target="inv"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="verdict" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="inv" target="resp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="tool loop" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;startArrow=classic;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="inv" target="itools"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="decision returned to DevAssist" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.2;exitY=0;entryX=0.7;entryY=0;" edge="1" parent="1" source="resp" target="tg"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2035" y="570"/><mxPoint x="893" y="570"/></Array></mxGeometry></mxCell><mxCell id="e11" value="ALLOW / SANITIZE: tool executes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;exitX=0.07;exitY=0;entryX=1;entryY=0.5;" edge="1" parent="1" source="resp" target="dtools"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1981" y="493"/></Array></mxGeometry></mxCell><mxCell id="e11b" value="POST (attack path)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#b85450;fontColor=#b85450;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="dtools" target="ext"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1696" y="400"/><mxPoint x="2160" y="400"/></Array></mxGeometry></mxCell><mxCell id="e12" value="ESCALATE: human Approve / Block" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;startArrow=classic;exitX=0.942;exitY=0;entryX=0.93;entryY=1;" edge="1" parent="1" source="resp" target="ui"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2344" y="347"/><mxPoint x="1120" y="347"/></Array></mxGeometry></mxCell><mxCell id="e13" value="log every event" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.167;exitY=1;entryX=0.094;entryY=0;" edge="1" parent="1" source="tg" target="d2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e14" value="