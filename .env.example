# Copy to .env and fill in. NEVER commit real keys.
# LLM provider used by DevAssist and the Investigator: openai | anthropic | deepseek
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Set to 1 to run fully offline (scripted DevAssist, canned Investigator).
MOCK_LLM=0

# SQLite audit log and policy file
POLICYGUARD_POLICY=./policy/devassist.yaml